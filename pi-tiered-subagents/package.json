{
  "name": "@code-fixer-23/pi-tiered-subagents",
  "type": "module",
  "version": "0.1.0",
  "keywords": [
    "pi-package"
  ],
  "description": "Family-aware subagent runtime for pi: scoped specialists, layered agent definitions, and inspectable model selection.",
  "files": [
    "extensions",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "LICENSE.upstream",
    "!**/*.test.ts"
  ],
  "exports": {
    ".": "./src/service/service.ts",
    "./settings": "./src/layered-settings.ts"
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/louiss0/pi-packages",
    "directory": "pi-tiered-subagents"
  },
  "homepage": "https://github.com/louiss0/pi-packages",
  "bugs": {
    "url": "https://github.com/louiss0/pi-packages/issues"
  },
  "dependencies": {
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "pi": {
    "extensions": [
      "extensions",
      "extensions/!*.test.ts"
    ],
    "image": ""
  }
}
